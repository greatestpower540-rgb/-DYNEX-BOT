
PORT=3000
NODE_ENV=development

# Meta WhatsApp Business Platform
WHATSAPP_VERIFY_TOKEN=replace_with_a_long_random_secret
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_API_VERSION=vXX.X

# Automatic replies are disabled until configured
AUTO_REPLY_ENABLED=false
DEFAULT_AUTO_REPLY=Thanks for contacting us! We have received your message and will respond shortly.
